{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "walk-speed-tuner",
    "version": "1.4.0",
    "default-features": [ "plugin" ],
    "features": {
        "plugin": {
            "description": "SKSE plugin DLL (CommonLibSSE-NG via git submodule)",
            "dependencies": [
                "nlohmann-json",
                {
                    "name": "spdlog",
                    "version>=": "1.16.0"
                },
                {
                    "name": "directxtk",
                    "version>=": "2025-10-27"
                },
                {
                    "name": "directxmath",
                    "version>=": "2025-04-03"
                },
                {
                    "name": "rapidcsv",
                    "version>=": "8.90"
                },
                {
                    "name": "fmt",
                    "version>=": "12.1.0"
                }
            ]
        },
        "tests": {
            "description": "Catch2 unit tests for pure-function modules (no SKSE)",
            "dependencies": [ "catch2", "nlohmann-json" ]
        }
    },
    "builtin-baseline": "ee12231b20c95013c6638d845d04c91559a1d1ff"
}
